<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aimc.launcher">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name="com.tungsten.fcl.FCLApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.AI_Minecraft_Launcher"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name="com.tungsten.fcl.activity.MainActivity"
            android:exported="false"
            android:label="Minecraft Launcher"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.tungsten.fcl.activity.DownloadActivity"
            android:exported="false"
            android:label="下载游戏版本"
            android:parentActivityName="com.tungsten.fcl.activity.MainActivity" />

        <activity
            android:name="com.tungsten.fcl.activity.ModSearchActivity"
            android:exported="false"
            android:label="Mod 搜索"
            android:parentActivityName="com.tungsten.fcl.activity.MainActivity" />

        <activity
            android:name="com.tungsten.fcl.activity.GameDirectoryActivity"
            android:exported="false"
            android:label="游戏目录"
            android:parentActivityName="com.tungsten.fcl.activity.MainActivity" />

        <activity
            android:name="com.tungsten.fcl.activity.AccountActivity"
            android:exported="false"
            android:label="账户管理"
            android:parentActivityName="com.tungsten.fcl.activity.MainActivity" />

        <activity
            android:name="com.tungsten.fcl.activity.VersionSettingsActivity"
            android:exported="false"
            android:label="版本设置"
            android:parentActivityName="com.tungsten.fcl.activity.MainActivity" />

        <service
            android:name=".service.AiControllerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
