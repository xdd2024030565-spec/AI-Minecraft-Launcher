<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="24dp" />

        <!-- API Key -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_api_key"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_api_key_hint"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp" />

        <!-- Model -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_model"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="+id/et_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_model_hint"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <!-- Base URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_base_url"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://api.openai.com/v1/"
            android:inputType="textUri"
            android:layout_marginBottom="16dp" />

        <!-- Bridge Port -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_bridge_port"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="+id/et_bridge_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="25580"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- Task -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_task"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="+id/et_task"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Explore the world and survive..."
            android:inputType="textMultiLine"
            android:gravity="top|start"
            android:layout_marginBottom="16dp" />

        <!-- Cycle Interval -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_cycle_interval"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="+id/et_cycle_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2000"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- Visual Mode -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="+id/switch_visual_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_visual_mode"
            android:layout_marginBottom="8dp" />

        <!-- Memory -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="+id/switch_memory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_memory"
            android:layout_marginBottom="24dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_save" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
