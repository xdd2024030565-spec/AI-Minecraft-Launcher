<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="8dp"
            android:text="@string/title_fcl"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:text="AI Minecraft Launcher"
            android:textSize="14sp"
            android:textColor="@color/on_background"
            android:alpha="0.6" />

        <!-- 启动 Minecraft 按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_minecraft"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:text="@string/start_minecraft"
            android:textSize="16sp" />

        <!-- 启动 AI 按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_ai"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:text="@string/start_ai"
            android:textSize="16sp"
            app:backgroundTint="@color/accent" />

        <!-- 停止 AI 按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stop_ai"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:text="@string/stop_ai"
            android:textSize="16sp"
            android:enabled="false"
            app:backgroundTint="@color/error" />

        <!-- AI 状态提示 -->
        <TextView
            android:id="@+id/tv_ai_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_status_stopped"
            android:textSize="14sp"
            android:textColor="@color/on_background"
            android:alpha="0.7" />

    </LinearLayout>
</ScrollView>
